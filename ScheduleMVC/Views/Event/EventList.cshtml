@model List<ScheduleMVC.Entities.Event>

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Event List</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />

</head>
<body class="hold-transition sidebar-mini">

    <div class="wrapper">

        <div class="content-wrapper" style="margin-left:0;">
            <section class="content pt-4">
                <div class="container">

                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title">Event List</h3>
                        </div>

                        <div class="card-body">

                            <a href="/Event/CreateEvent" class="btn btn-success mb-3">
                                Add New Event
                            </a>

                            <a href="/Schedule/Index" class="btn btn-secondary mb-3">
                                Back to Calendar
                            </a>

                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Title</th>
                                        <th>Department</th>
                                        <th>Color</th>
                                        <th>Delete</th>
                                        <th>Update</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td>@item.EventId</td>
                                            <td>@item.Title</td>
                                            <td>@item.Department.DepartmentName</td>
                                            <td>
                                                <span class="badge" style="background-color:@item.Department.Color; color:white;">
                                                    @item.Department.Color
                                                </span>
                                            </td>
                                            <td>
                                                <a href="/Event/DeleteEvent/@item.EventId"
                                                   class="btn btn-danger btn-sm">
                                                    Delete
                                                </a>
                                            </td>
                                            <td>
                                                <a href="/Event/UpdateEvent/@item.EventId"
                                                   class="btn btn-warning btn-sm">
                                                    Update
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>

                        </div>
                    </div>

                </div>
            </section>
        </div>

    </div>

  
</body>
</html>