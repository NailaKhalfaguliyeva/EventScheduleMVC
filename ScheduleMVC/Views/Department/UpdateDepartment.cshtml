@model ScheduleMVC.Entities.Department

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Update Department</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
   
</head>
<body class="hold-transition">

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-7">

                <div class="card card-warning shadow">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-edit"></i> Update Department
                        </h3>
                    </div>

                    <div class="card-body">
                        <form method="post">

                            @Html.HiddenFor(x => x.DepartmentId)

                            <div class="form-group">
                                <label>Department Name</label>
                                @Html.TextBoxFor(x => x.DepartmentName, new { @class = "form-control" })
                            </div>

                            <div class="form-group">
                                <label>Color</label>
                                @Html.TextBoxFor(x => x.Color, new { @class = "form-control" })
                            </div>

                            <button type="submit" class="btn btn-warning">
                                Update
                            </button>

                            <a href="/Department/DepartmentList" class="btn btn-secondary">
                                Go Back
                            </a>

                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>

</body>
</html>